# =============================================================================
# Kyptic API Security Platform Environment Configuration Template
# Copy this file to '.env' and adjust variables for your target environment.
# =============================================================================

# -----------------------------------------------------------------------------
# AI Security Copilot Settings
# -----------------------------------------------------------------------------
# LLM Provider Selection: 'ollama' or 'openai' (Default: ollama)
COPILOT_PROVIDER=ollama

# Ollama Integration Settings (used when COPILOT_PROVIDER=ollama)
# Default URL for local Ollama daemon
COPILOT_OLLAMA_URL=http://localhost:11434
# Local LLM model name installed in Ollama (e.g., qwen2.5-coder:1.5b, llama3:8b)
COPILOT_OLLAMA_MODEL=qwen2.5-coder:1.5b

# OpenAI-compatible Integration Settings (used when COPILOT_PROVIDER=openai)
# Base URL for OpenAI or any OpenAI-compatible API endpoint (vLLM, LocalAI, LM Studio)
COPILOT_OPENAI_URL=https://api.openai.com/v1
# Secret API Key (Placeholder only - NEVER commit real credentials)
COPILOT_OPENAI_API_KEY=your_openai_api_key_here
# OpenAI-compatible Model Identifier
COPILOT_OPENAI_MODEL=gpt-3.5-turbo

# Copilot Execution & Latency Bounds
# Request timeout in seconds before falling back to the deterministic security advisory engine
COPILOT_TIMEOUT_SECONDS=8.0
# Maximum context character limit per prompt to fit local LLM context windows
COPILOT_MAX_CONTEXT_CHARS=4000
# Maximum token output limit
COPILOT_MAX_RESPONSE_TOKENS=512
# Enable Server-Sent Events (SSE) response streaming (true/false)
COPILOT_ENABLE_STREAMING=true

# -----------------------------------------------------------------------------
# DAST & Target Network Settings
# -----------------------------------------------------------------------------
# Permit scanning localhost and 127.0.0.1 loopback addresses in development
ALLOW_LOCALHOST=true
