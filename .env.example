# =============================================================================
# Kyptic API Security Platform Environment Configuration Template
# Copy this file to '.env' and adjust variables for your target environment.
# =============================================================================

# -----------------------------------------------------------------------------
# Core Application & Environment Settings
# -----------------------------------------------------------------------------
APP_ENV=development
SECRET_KEY=change-this-to-a-secure-random-secret-in-production

# -----------------------------------------------------------------------------
# Database Architecture & Connection Settings (PostgreSQL Primary)
# -----------------------------------------------------------------------------
# SQLite fallback (Development default): sqlite:///kyptic.db
# PostgreSQL Development: postgresql+psycopg2://kyptic:kyptic_dev_pass@localhost:5432/kyptic_db
# PostgreSQL Managed (RDS/Aurora): postgresql+psycopg2://user:password@db-cluster.rds.amazonaws.com:5432/kyptic_prod
DATABASE_URL=postgresql+psycopg2://kyptic:kyptic_dev_pass@localhost:5432/kyptic_db

# Isolated Test Database URL (MUST be separate from production/dev database)
TEST_DATABASE_URL=sqlite:///:memory:

# -----------------------------------------------------------------------------
# Storage Abstraction Settings
# -----------------------------------------------------------------------------
# Storage Provider: 'local' or 's3' (Default: local)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=data
# AWS S3 Settings (used when STORAGE_PROVIDER=s3)
S3_BUCKET_NAME=kyptic-artifacts
S3_REGION=us-east-1
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# -----------------------------------------------------------------------------
# DAST & Target Network Security Settings
# -----------------------------------------------------------------------------
# Explicit local target for development scanning exception (never globally disables SSRF)
KYPTIC_LOCAL_DEMO_URL=http://localhost:8001
ALLOW_LOCALHOST=true

# -----------------------------------------------------------------------------
# AI Security Copilot Settings (Out of Scope for Core Platform)
# -----------------------------------------------------------------------------
COPILOT_PROVIDER=ollama
COPILOT_OLLAMA_URL=http://localhost:11434
COPILOT_OLLAMA_MODEL=qwen2.5-coder:1.5b
COPILOT_OPENAI_URL=https://api.openai.com/v1
COPILOT_OPENAI_API_KEY=your_openai_api_key_here
COPILOT_OPENAI_MODEL=gpt-3.5-turbo
COPILOT_TIMEOUT_SECONDS=8.0
COPILOT_MAX_CONTEXT_CHARS=4000
COPILOT_MAX_RESPONSE_TOKENS=512
COPILOT_ENABLE_STREAMING=true
